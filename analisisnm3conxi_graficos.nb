Cell[BoxData[
 RowBox[{
  RowBox[{"HubbleParameter", "[", 
   RowBox[{"\[Xi]_", ",", " ", "t_"}], "]"}], ":=", " ", 
  SqrtBox[
   RowBox[{
    FractionBox[
     RowBox[{"8", "\[Pi]", " ", "G"}], 
     RowBox[{"3", 
      RowBox[{"c", "^", "2"}]}]], 
    RowBox[{"(", 
