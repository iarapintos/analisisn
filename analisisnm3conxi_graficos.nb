 RowBox[{
  RowBox[{"DDotA", "[", 
   RowBox[{
    RowBox[{"\[Xi]_", "?", "NumericQ"}], ",", 
    RowBox[{"t_", "?", "NumericQ"}]}], "]"}], ":=", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"DotA", "[", 
      RowBox[{"\[Xi]", ",", 
       RowBox[{"t", "+", 
        RowBox[{"10", "^", 
         RowBox[{"-", "6"}]}]}]}], "]"}], "-", 
     RowBox[{"DotA", "[", 
      RowBox[{"\[Xi]", ",", 
       RowBox[{"t", "-", 
        RowBox[{"10", "^", 
         RowBox[{"-", "6"}]}]}]}], "]"}]}], ")"}], "/", 
   RowBox[{"(", 
    RowBox[{"2", "*", 
