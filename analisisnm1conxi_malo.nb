Cell[BoxData[
 RowBox[{
  RowBox[{"\[Rho]rad", "[", 
   RowBox[{"\[Xi]_", ",", " ", "t_"}], "]"}], ":=", " ", 
  RowBox[{
   RowBox[{
    FractionBox[
     RowBox[{"3", 
      RowBox[{"c", "^", "2"}]}], 
     RowBox[{"8", "\[Pi]", " ", "G"}]], 
    RowBox[{
     RowBox[{"(", 
      FractionBox[
       RowBox[{"DotA", "[", 
        RowBox[{"\[Xi]", ",", " ", "t"}], "]"}], 
       RowBox[{"apos", "[", 
        RowBox[{"\[Xi]", ",", " ", "t"}], "]"}]], ")"}], "^", "2"}]}], " ", 
   "-", 
   RowBox[{"\[Rho]bh", "[", 
    RowBox[{"\[Xi]", ",", " ", "t"}], "]"}]}]}]], "Input",
