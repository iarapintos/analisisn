Cell[BoxData[{
 RowBox[{
  RowBox[{"tMin", "=", 
   RowBox[{"-", "5"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"n", " ", "=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "1"}], " ", "luego", " ", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"Y", "[", "t", "]"}], ")"}], "^", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"n", "-", "1"}], ")"}], "/", "2"}], ")"}], " ", "--"}], 
        "--"}]}]}], ">", " ", 
     RowBox[{"Y", "^", 
      RowBox[{"-", "1"}]}]}]}], "\[IndentingNewLine]", "*)"}]}]}], "Input",
