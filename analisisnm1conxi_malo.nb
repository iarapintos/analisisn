Cell[BoxData[
 RowBox[{
  RowBox[{"HubbleParameter", "[", 
   RowBox[{"\[Xi]_", ",", " ", "t_"}], "]"}], ":=", " ", 
  SqrtBox[
   RowBox[{
    FractionBox[
     RowBox[{"8", "\[Pi]", " ", "G"}], 
     RowBox[{"3", 
      RowBox[{"c", "^", "2"}]}]], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"\[Rho]rad", "[", 
       RowBox[{"\[Xi]", ",", " ", "t"}], "]"}], "+", 
      RowBox[{"\[Rho]bh", "[", 
       RowBox[{"\[Xi]", ",", " ", "t"}], "]"}]}], ")"}]}]]}]], "Input",
 CellChangeTimes->{{4.000212727255258*^9, 4.000212727410557*^9}, {
  4.000212773612405*^9, 4.000212786584283*^9}},
 CellLabel->
  "In[130]:=",ExpressionUUID->"97937f60-db27-4537-aea5-3ceadcedaf30"],

