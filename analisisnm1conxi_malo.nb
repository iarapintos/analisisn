Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"sol", "[", "\[Xi]_", "]"}], ":=", 
    RowBox[{
     RowBox[{"sol", "[", "\[Xi]", "]"}], "=", 
     RowBox[{"NDSolve", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Y", "'"}], "[", "t", "]"}], "==", 
          RowBox[{"v", "[", "t", "]"}]}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"v", "'"}], "[", "t", "]"}], "==", 
          RowBox[{"2", "*", 
           RowBox[{"Cxi", "[", "\[Xi]", "]"}], "*", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"Y", "[", "t", "]"}], ")"}], "^", 
            RowBox[{"(", 
             RowBox[{"-", "1"}], ")"}]}]}]}], ",", 
         RowBox[{
          RowBox[{"Y", "[", "ti", "]"}], "==", "1"}], ",", 
         RowBox[{
          RowBox[{"v", "[", "ti", "]"}], "==", 
          RowBox[{"2", "*", "Hti"}]}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"Y", ",", "v"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "tMin", ",", "ti"}], "}"}], ",", 
       RowBox[{"WorkingPrecision", "->", "40"}], ",", 
       RowBox[{"AccuracyGoal", "->", "25"}], ",", 
       RowBox[{"PrecisionGoal", "->", "25"}], ",", "\[IndentingNewLine]", 
       RowBox[{"Method", "->", "\"\<StiffnessSwitching\>\""}], ",", 
       RowBox[{"MaxSteps", "->", "Infinity"}]}], " ", "]"}]}]}], ";"}], 
  "\[IndentingNewLine]"}]], "Input",
 CellChangeTimes->{{4.0002081634770117`*^9, 4.000208164825304*^9}, {
