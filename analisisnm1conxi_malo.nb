 CellChangeTimes->{{4.0002081686840553`*^9, 4.000208174719693*^9}},
 CellLabel->"In[7]:=",ExpressionUUID->"3e12bf59-3dbf-41d0-8675-a7166aabafd3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Cxi", "[", "\[Xi]_", "]"}], ":=", " ", 
  RowBox[{
   FractionBox[
    RowBox[{"4", "\[Pi]", " ", "G"}], 
    RowBox[{"3", 
     RowBox[{"c", "^", "2", " "}]}]], "*", 
   RowBox[{"\[Rho]0", "[", "\[Xi]", "]"}]}]}]], "Input",
