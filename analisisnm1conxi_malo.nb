Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"c", ",", "G", ",", "MSun", ",", "rhoRadBBN"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"c", "=", "29979245800"}], ";"}], "                   ", 
  RowBox[{"(*", 
   RowBox[{"velocidad", " ", "de", " ", "la", " ", 
    RowBox[{"luz", ":", 
     RowBox[{"cm", "/", "s"}]}]}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"G", "=", 
    RowBox[{"66743", "/", 
     RowBox[{"10", "^", "12"}]}]}], ";"}], "                   ", 
  RowBox[{"(*", 
   RowBox[{"constante", " ", 
    RowBox[{"gravitacional", ":", 
     RowBox[{
      RowBox[{"cm", "^", "3"}], "/", 
      RowBox[{"(", 
       RowBox[{"g", " ", 
        RowBox[{"s", "^", "2"}]}], ")"}]}]}]}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"MSun", "=", 
    RowBox[{"198847", "*", 
     RowBox[{"10", "^", "28"}]}]}], ";"}], "               ", 
  RowBox[{"(*", 
   RowBox[{"masa", " ", 
    RowBox[{"solar", ":", "g"}]}], "*)"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rhoRadBBN", "=", 
   RowBox[{"7331305019814086", "*", 
    RowBox[{"10", "^", "11"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "densidad", " ", "de", " ", "energ\[IAcute]a", " ", "de", " ", 
    "radiaci\[OAcute]n", " ", "en", " ", 
    RowBox[{"BBN", ":", 
     RowBox[{"erg", "/", 
      RowBox[{"cm", "^", "3"}]}]}]}], "*)"}]}]}], "Input",
 CellLabel->"In[1]:=",ExpressionUUID->"7b4f4f8c-b8a7-47cf-8bcd-18206ea9ac78"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ti", "=", 
   RowBox[{"37", "/", "50"}]}], ";", "                       ", 
  RowBox[{"(*", 
   RowBox[{"coordenada", " ", "temporal", " ", "de", " ", 
    RowBox[{"BBN", ":", 
     RowBox[{"0.74", " ", "s"}]}]}], "*)"}], "\n", 
  RowBox[{"ai", "=", 
   RowBox[{"83", "/", "500000000000"}]}], ";", "             ", 
  RowBox[{"(*", 
   RowBox[{"factor", " ", "de", " ", "escala", " ", "en", " ", 
    RowBox[{"BBN", ":", 
     RowBox[{"1.66", "*", 
      RowBox[{"10", "^", 
       RowBox[{"-", "10"}]}]}]}]}], "*)"}], "\n", 
  RowBox[{"Hti", "=", 
   RowBox[{"67", "/", "100"}]}], ";", "                     ", 
  RowBox[{"(*", 
   RowBox[{"par\[AAcute]metro", " ", "de", " ", "Hubble", " ", "en", " ", 
    RowBox[{"BBN", ":", 
     RowBox[{"0.67", " ", 
      RowBox[{"s", "^", 
       RowBox[{"-", "1"}]}]}]}]}], "*)"}]}]], "Input",
 CellChangeTimes->{{4.000208021369205*^9, 4.0002080293457813`*^9}},
