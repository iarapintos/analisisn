Cell[BoxData[
 RowBox[{
  RowBox[{"sol", " ", "=", 
   RowBox[{"NDSolve", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Y", "'"}], "[", "t", "]"}], " ", "==", " ", 
        RowBox[{"v", "[", "t", "]"}]}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"v", "'"}], "[", "t", "]"}], " ", "==", " ", 
        RowBox[{"2", "*", 
         RowBox[{"Cxi", "[", 
          RowBox[{"1", "/", "10"}], "]"}], "*", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"Y", "[", "t", "]"}], ")"}], "^", 
          RowBox[{"(", 
           RowBox[{"-", "1"}], ")"}]}]}]}], ",", " ", 
       RowBox[{
        RowBox[{"Y", "[", "ti", "]"}], "==", "1"}], ",", 
       RowBox[{
        RowBox[{"v", "[", "ti", "]"}], "==", 
        RowBox[{"2", "*", "Hti"}]}], ",", 
       RowBox[{"WhenEvent", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Y", "[", "t", "]"}], "==", "0"}], ",", 
         "\"\<StopIntegration\>\"", ",", 
         RowBox[{"\"\<LocationMethod\>\"", "->", "\"\<Brent\>\""}]}], "]"}]}],
       "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"Y", ",", "v"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "tMin", ",", "ti"}], "}"}], ",", 
     RowBox[{"WorkingPrecision", "->", "40"}], ",", 
     RowBox[{"AccuracyGoal", "->", "25"}], ",", 
     RowBox[{"PrecisionGoal", "->", "25"}], ",", 
     RowBox[{"MaxStepFraction", "->", 
      RowBox[{"1", "/", "1000"}]}], ",", 
