   RowBox[{"velocidad", " ", "de", " ", "la", " ", 
    RowBox[{"luz", ":", 
     RowBox[{"cm", "/", "s"}]}]}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"G", "=", 
