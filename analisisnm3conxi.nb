     RowBox[{"10", "^", "12"}]}]}], ";"}], "                   ", 
  RowBox[{"(*", 
   RowBox[{"constante", " ", 
    RowBox[{"gravitacional", ":", 
     RowBox[{
      RowBox[{"cm", "^", "3"}], "/", 
      RowBox[{"(", 
       RowBox[{"g", " ", 
        RowBox[{"s", "^", "2"}]}], ")"}]}]}]}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"MSun", "=", 
    RowBox[{"198847", "*", 
     RowBox[{"10", "^", "28"}]}]}], ";"}], "               ", 
  RowBox[{"(*", 
   RowBox[{"masa", " ", 
    RowBox[{"solar", ":", "g"}]}], "*)"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rhoRadBBN", "=", 
   RowBox[{"7331305019814086", "*", 
    RowBox[{"10", "^", "11"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "densidad", " ", "de", " ", "energ\[IAcute]a", " ", "de", " ", 
    "radiaci\[OAcute]n", " ", "en", " ", 
    RowBox[{"BBN", ":", 
     RowBox[{"erg", "/", 
