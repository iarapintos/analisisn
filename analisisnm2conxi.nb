     RowBox[{"10", "^", "28"}]}]}], ";"}], "               ", 
  RowBox[{"(*", 
   RowBox[{"masa", " ", 
    RowBox[{"solar", ":", "g"}]}], "*)"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"rhoRadBBN", "=", 
