Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"sol", "[", "\[Xi]_", "]"}], ":=", 
   RowBox[{
    RowBox[{"sol", "[", "\[Xi]", "]"}], "=", 
    RowBox[{"Quiet", "@", 
     RowBox[{"NDSolve", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Y", "'"}], "[", "t", "]"}], "==", 
          RowBox[{"v", "[", "t", "]"}]}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"v", "'"}], "[", "t", "]"}], "==", 
          RowBox[{"2", "*", 
           RowBox[{"Cxi", "[", "\[Xi]", "]"}], "*", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"Y", "[", "t", "]"}], ")"}], "^", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"-", "3"}], "/", "2"}], ")"}]}]}]}], ",", 
         RowBox[{
          RowBox[{"Y", "[", "ti", "]"}], "==", "1"}], ",", 
         RowBox[{
          RowBox[{"v", "[", "ti", "]"}], "==", 
          RowBox[{"2", "*", "Hti"}]}], ",", 
         RowBox[{"WhenEvent", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"v", "[", "t", "]"}], "==", "0"}], ",", 
           "\"\<StopIntegration\>\""}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"Y", ",", "v"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", 
         RowBox[{"-", "1"}], ",", "ti"}], "}"}], ",", 
       RowBox[{"WorkingPrecision", "->", "40"}], ",", 
       RowBox[{"AccuracyGoal", "->", "20"}], ",", 
       RowBox[{"PrecisionGoal", "->", "20"}], ",", 
       RowBox[{"Method", "->", "\"\<StiffnessSwitching\>\""}], ",", 
       RowBox[{"MaxSteps", "->", "Infinity"}]}], "]"}]}]}]}], ";"}]], "Input",\

