    RowBox[{"BBN", ":", 
     RowBox[{"0.74", " ", "s"}]}]}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"ai", "=", 
    RowBox[{"83", "/", "500000000000"}]}], ";"}], "             ", 
  RowBox[{"(*", 
   RowBox[{"factor", " ", "de", " ", "escala", " ", "en", " ", 
    RowBox[{"BBN", ":", 
     RowBox[{"1.66", "*", 
      RowBox[{"10", "^", 
       RowBox[{"-", "10"}]}]}]}]}], "*)"}]}], "\n", 
 RowBox[{
