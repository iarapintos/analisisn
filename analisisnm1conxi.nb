 RowBox[{
  RowBox[{"tMin", "=", 
   RowBox[{"-", "5"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"n", " ", "=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "1"}], " ", "luego", " ", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"(", 
