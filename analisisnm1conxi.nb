 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"n", " ", "=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "1"}], " ", "luego", " ", "\[IndentingNewLine]", 
      RowBox[{
