Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"sol", "[", "\[Xi]_", "]"}], ":=", 
   RowBox[{
    RowBox[{"sol", "[", "\[Xi]", "]"}], "=", 
    RowBox[{"NDSolve", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Y", "'"}], "[", "t", "]"}], "==", 
         RowBox[{"v", "[", "t", "]"}]}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"v", "'"}], "[", "t", "]"}], "==", 
         RowBox[{"2", "*", 
          RowBox[{"Cxi", "[", "\[Xi]", "]"}], "*", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"Y", "[", "t", "]"}], ")"}], "^", 
           RowBox[{"(", 
            RowBox[{"-", "1"}], ")"}]}]}]}], ",", 
        RowBox[{
         RowBox[{"Y", "[", "ti", "]"}], "==", "1"}], ",", 
        RowBox[{
         RowBox[{"v", "[", "ti", "]"}], "==", 
         RowBox[{"2", "*", "Hti"}]}], ",", 
        RowBox[{"WhenEvent", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"v", "[", "t", "]"}], "==", "0"}], ",", 
          "\"\<StopIntegration\>\"", ",", 
          RowBox[{"\"\<LocationMethod\>\"", "->", "\"\<Brent\>\""}]}], 
         "]"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"Y", ",", "v"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", 
        RowBox[{"-", "1"}], ",", "ti"}], "}"}], ",", 
      RowBox[{"WorkingPrecision", "->", "40"}], ",", 
      RowBox[{"AccuracyGoal", "->", "25"}], ",", 
      RowBox[{"PrecisionGoal", "->", "25"}], ",", 
      RowBox[{"MaxStepSize", "->", 
       RowBox[{"1", "/", "1000"}]}], ",", 
      RowBox[{"MaxSteps", "->", "Infinity"}]}], "]"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{4.000214947384686*^9, 4.000214967632766*^9}},
 CellLabel->
